# ============================================================
# CONFIGURATION DU PROJET AutoLoc
# ============================================================
# Comment l'utiliser :
# 1. Copier ce fichier en ".env" : cp .env.example .env
# 2. Modifier les valeurs dans .env selon ton environnement
# 3. NE JAMAIS commiter .env dans Git (deja exclu par .gitignore)
# ============================================================

# === Django ===
DJANGO_SECRET_KEY=django-insecure-changez-moi-en-production-autoloc-jwt-2025
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# === Base de donnees MySQL (XAMPP) ===
DB_NAME=autoloc_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# === JWT (en jours) ===
JWT_ACCESS_LIFETIME_DAYS=7
JWT_REFRESH_LIFETIME_DAYS=30

# === CORS ===
CORS_ALLOW_ALL_ORIGINS=True
